{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "Rayman 3 HD Recompiled",
  "repo": "MysteriousAeon/rayman3-hd-recompiled",
  "inputs": [
    {
      "id": "game",
      "label": "Your Rayman 3 HD package for Xbox 360: the Xbox Live Arcade release (title ID 5841123F) without a title update, the file with no extension under Content\\0000000000000000\\5841123F\\000D0000\\ on your console's storage. Its verified extracted folder works too.",
      "formats": [{ "type": "file" }, { "type": "folder" }]
    }
  ],
  "start": {
    "program": ["app/python/pythonw.exe"],
    "args": ["-B", "{install}/app/tools/r3hd_portable.py", "play", "--wait"]
  },
  "prepare": {
    "program": ["app/python/python.exe"],
    "args": ["-B", "{install}/app/tools/r3hd_portable.py", "prepare", "--game={input:game}", "--no-input", "--progress", "--in-place-update"],
    "label": "Game data from your package",
    "done": ["{install}/installer.json", "{install}/data/intake.json"],
    "keeps_copy": true
  },
  "config": [
    {
      "id": "main",
      "format": "json",
      "file": [{ "path": "{install}/settings.json" }]
    }
  ],
  "settings": [
    {
      "id": "display", "label": "Display mode", "group": "Display",
      "help": "Fullscreen uses your desktop resolution (borderless).",
      "choices": [
        { "label": "Fullscreen", "set": { "preferences/display": "fullscreen" } },
        { "label": "Window", "set": { "preferences/display": "windowed" } }
      ],
      "defaults": { "preferences/display": "windowed" }
    },
    {
      "id": "window_size", "label": "Window size", "group": "Display",
      "help": "In screen pixels, for Window mode; reduced to fit your screen.",
      "choices": [
        { "label": "Default (1280 x 720)", "set": { "preferences/window_size": "auto" } },
        { "label": "1280 x 720", "set": { "preferences/window_size": "1280x720" } },
        { "label": "1600 x 900", "set": { "preferences/window_size": "1600x900" } },
        { "label": "1920 x 1080", "set": { "preferences/window_size": "1920x1080" } },
        { "label": "2560 x 1440", "set": { "preferences/window_size": "2560x1440" } }
      ],
      "defaults": { "preferences/window_size": "auto", "preferences/display": "windowed" },
      "when": { "preferences/display": "windowed" }
    },
    {
      "id": "render_scale", "label": "Rendering resolution", "group": "Display",
      "help": "Auto picks 720p, 1440p or 2160p to cover the game's picture. 720p is the console's own; pick it if the game runs slowly.",
      "choices": [
        { "label": "Auto", "set": { "preferences/render_scale": "auto" } },
        { "label": "720p (1x, original)", "set": { "preferences/render_scale": "1" } },
        { "label": "1080p (1.5x)", "set": { "preferences/render_scale": "1.5" } },
        { "label": "1440p (2x)", "set": { "preferences/render_scale": "2" } },
        { "label": "2160p (3x)", "set": { "preferences/render_scale": "3" } }
      ],
      "defaults": { "preferences/render_scale": "auto" }
    },
    {
      "id": "display_vsync", "label": "V-Sync", "group": "Display",
      "help": "Prevents screen tearing; can add slight input delay. The game still runs at 60 FPS.",
      "choices": [
        { "label": "Off", "set": { "preferences/display_vsync": "off" } },
        { "label": "On", "set": { "preferences/display_vsync": "on" } }
      ],
      "defaults": { "preferences/display_vsync": "off" }
    },
    {
      "id": "game_language", "label": "Game language", "group": "Game",
      "help": "Text, subtitles and voices, from the next start. The Turkish and Brazilian Portuguese mods need English.",
      "choices": [
        { "label": "English", "set": { "preferences/game_language": "en" } },
        { "label": "Français", "set": { "preferences/game_language": "fr" } },
        { "label": "Español", "set": { "preferences/game_language": "es" } },
        { "label": "Italiano", "set": { "preferences/game_language": "it" } },
        { "label": "Deutsch", "set": { "preferences/game_language": "de" } }
      ],
      "defaults": { "preferences/game_language": "en" }
    },
    {
      "id": "gameplay_subtitles", "label": "Gameplay subtitles", "group": "Game",
      "help": "Subtitles for voiced dialogue outside cutscenes too. The game's own Subtitles option still applies.",
      "choices": [
        { "label": "Off", "set": { "preferences/gameplay_subtitles": "original" } },
        { "label": "On", "set": { "preferences/gameplay_subtitles": "all" } }
      ],
      "defaults": { "preferences/gameplay_subtitles": "original" }
    }
  ],
  "saves": ["{install}/profiles"],
  "folders": {
    "game": [{ "path": "{install}/data/content" }],
    "saves": [{ "path": "{install}/profiles" }],
    "logs": [{ "path": "{install}/cache" }],
    "sessions": [{ "path": "{install}/sessions" }],
    "mods": [{ "path": "{install}/mods" }]
  },
  "actions": [
    { "id": "saves", "label": "Saves", "help": "Your saves and achievements.", "open": "saves" },
    { "id": "sessions", "label": "Session logs", "help": "Each play session's logs and support_report.txt, for a bug report.", "open": "sessions" }
  ],
  "exit_codes": {
    "2": "Rayman 3 HD Recompiled stopped before the game started. If its program files or your game data changed, press Set Up Again on the game's page; cache\\launcher_play.log has the details."
  },
  "looks": {
    "allowed": false,
    "reason": "The game checks its program files before every start, so a look can't be added beside them."
  },
  "system": {
    "windows": { "version": "10.0.18362" }
  }
}
