# LX-5 (E-375, B3): the export list of libffmpeg.so on Linux, the counterpart of m46_ffmpeg_def.cmake.
#
# The same selection as the Windows .def: every external symbol the static libavutil / libavcodec archives define
# whose name starts with "av" (upstream's libavutil.v / libavcodec.v). The output is an implicit GNU linker script
# with EXTERN(...), so the linker pulls exactly the archive members that define them (a symbol defined in both
# archives, file_open.c, is linked once, from the first archive, as before); the version script beside it keeps only
# av* global. GNU ld and lld both read EXTERN in an implicit script.
#
# cmake -DNM=<nm> -DAVUTIL=<libavutil.a> -DAVCODEC=<libavcodec.a> -DOUT=<ffmpeg_exports.ld> -P m46_ffmpeg_so.cmake
foreach(v NM AVUTIL AVCODEC OUT)
  if(NOT DEFINED ${v})
    message(FATAL_ERROR "m46_ffmpeg_so: ${v} not set")
  endif()
endforeach()
execute_process(
  COMMAND "${NM}" --defined-only --extern-only "${AVUTIL}" "${AVCODEC}"
  OUTPUT_VARIABLE listing
  RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "m46_ffmpeg_so: ${NM} failed (${rc})")
endif()
string(REPLACE "\r" "" listing "${listing}")
string(REPLACE ";" "" listing "${listing}")
string(REPLACE "\n" ";" lines "${listing}")
set(names)
foreach(line IN LISTS lines)
  # ELF nm: "<value> <type> <name>"; external defined code (T), data (D, B, R) and the rest that nm marks upper-case.
  if(line MATCHES "^[0-9a-fA-F]+ ([A-Z]) (av[A-Za-z0-9_]*)$")
    list(APPEND names "${CMAKE_MATCH_2}")
  endif()
endforeach()
list(REMOVE_DUPLICATES names)
list(SORT names)
list(LENGTH names n)
if(n LESS 100)
  message(FATAL_ERROR "m46_ffmpeg_so: only ${n} av* symbols found; wrong archives?")
endif()
set(text "/* LX-5: generated by m46_ffmpeg_so.cmake; the av* symbols libffmpeg.so exports. */\nEXTERN(\n")
foreach(s IN LISTS names)
  string(APPEND text "  ${s}\n")
endforeach()
string(APPEND text ")\n")
# Rewrite only on change, so an unchanged list does not relink the library.
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL text)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${text}")
