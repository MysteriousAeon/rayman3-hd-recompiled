    {"glob": "config/**/*.toml", "kind": "toml"},
    {"glob": "config/**/*.txt", "kind": "text"},
    {"glob": "config/**/*.tsv", "kind": "tsv"},
    {"glob": "config/localization/**/*.md", "kind": "markdown"},
    {"glob": "docs/**/*.md", "kind": "markdown"},
    {"glob": "docs/licensing/*.txt", "kind": "text"},
    {"glob": "reports/**/*.md", "kind": "markdown"},
