    {"glob": "tools/**/*.bat", "kind": "batch"},
    {"glob": "tools/**/*.sh", "kind": "shell"},
    {"glob": "tools/installer/*.iss", "kind": "text"},
    {"glob": "tools/installer/*.txt", "kind": "text"},
    {"glob": "tools/installer/*.isl", "kind": "text"},
    {"glob": "tools/installer/MODDING.md", "kind": "markdown"},
    {"glob": "tools/installer/*.cmd", "kind": "batch"},
    {"glob": "tools/replay/*.cmd", "kind": "batch"},
    {"glob": "tools/**/*.cpp", "kind": "cpp_source"},
    {"glob": "tools/**/*.h", "kind": "cpp_header"},
