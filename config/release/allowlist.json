{
  "schema": 1,
  "note": "Positive allowlist for the source-only release package (G-PKG, D-059), used by tools/r3hd_release_audit.py. Anything not matched by an 'allow' glob is rejected (fail closed). Globs are POSIX, relative to the package root; '*' does not cross '/', '**/' matches zero or more directories. Every kind is a text kind: the audit also requires valid UTF-8 without NUL bytes. deny_paths are root-relative directory prefixes, deny_segments are path segments at any depth (both case-insensitive). The audit is technical only and is NOT a legal clearance.",
  "max_text_file_bytes": 4194304,
  "deny_paths": ["private/", "external/", "generated/", "out/", "build/"],
  "deny_segments": [".git", "__pycache__"],
  "allow": [
